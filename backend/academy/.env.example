# Academy backend local defaults
ACADEMY_DB_URL=sqlite:///backend/academy/academy.db

# Optional OpenAI provider settings
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated allowed frontend origins for CORS (staging/prod set this explicitly)
ACADEMY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
